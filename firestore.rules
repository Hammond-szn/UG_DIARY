rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.updatedAt == request.time;
      allow read: if signedIn() && request.auth.uid == userId;
    }

    match /presence/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.isOnline is bool
        && request.resource.data.lastSeen is timestamp
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /chatRooms/{roomId} {
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.name is string
        && request.resource.data.participants is list
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'text', 'attachmentUrl', 'attachmentType',
            'createdAt', 'editedAt', 'deletedAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.text.size() > 0
            || (request.resource.data.attachmentUrl is string
              && request.resource.data.attachmentUrl.size() > 0
              && request.resource.data.attachmentUrl.size() <= 2000))
          && (!request.resource.data.keys().hasAny(['attachmentUrl'])
            || (request.resource.data.attachmentUrl is string
              && request.resource.data.attachmentUrl.size() <= 2000))
          && (!request.resource.data.keys().hasAny(['attachmentType'])
            || request.resource.data.attachmentType in ['', 'image', 'audio'])
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn()
          && request.auth.uid == resource.data.senderId
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'attachmentUrl', 'editedAt', 'deletedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
            && request.resource.data.attachmentUrl is string
            && request.resource.data.attachmentUrl.size() <= 2000
            && ((request.resource.data.deletedAt == resource.data.deletedAt
                && request.resource.data.editedAt == request.time)
              || (request.resource.data.deletedAt == request.time
                && request.resource.data.text == 'This message was deleted.'));
        allow delete: if false;
      }
    }

    match /posts/{postId} {
      function validVoteUpdate() {
        let oldVotes = resource.data.votes;
        let newVotes = request.resource.data.votes;
        let oldVote = oldVotes.get(request.auth.uid, 0);
        let newVote = newVotes.get(request.auth.uid, 0);

        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['votes', 'upvotes', 'downvotes'])
          && newVotes is map
          && newVotes.diff(oldVotes).affectedKeys().hasOnly([request.auth.uid])
          && oldVote in [-1, 0, 1]
          && newVote in [-1, 0, 1]
          && request.resource.data.upvotes
              == resource.data.upvotes + (newVote == 1 ? 1 : 0) - (oldVote == 1 ? 1 : 0)
          && request.resource.data.downvotes
              == resource.data.downvotes + (newVote == -1 ? 1 : 0) - (oldVote == -1 ? 1 : 0);
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId', 'category', 'campus', 'text', 'votes',
          'upvotes', 'downvotes', 'createdAt', 'location', 'imageUrl', 'audioUrl'
        ])
        && request.resource.data.keys().hasAll([
          'authorId', 'category', 'campus', 'text', 'votes',
          'upvotes', 'downvotes', 'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.category in [
          'Campus', 'Question', 'Confession', 'Lost & Found', 'Opportunity'
        ]
        && request.resource.data.campus == 'University of Ghana'
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && (request.resource.data.text.size() > 0
          || request.resource.data.keys().hasAny(['imageUrl', 'audioUrl']))
        && (!request.resource.data.keys().hasAny(['imageUrl'])
          || (request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() > 0
            && request.resource.data.imageUrl.size() <= 2000))
        && (!request.resource.data.keys().hasAny(['audioUrl'])
          || (request.resource.data.audioUrl is string
            && request.resource.data.audioUrl.size() > 0
            && request.resource.data.audioUrl.size() <= 2000))
        && request.resource.data.votes is map
        && request.resource.data.votes.size() == 0
        && request.resource.data.upvotes == 0
        && request.resource.data.downvotes == 0
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['location'])
          || (request.resource.data.location is map
            && request.resource.data.location.keys().hasOnly(['latitudeCell', 'longitudeCell'])
            && request.resource.data.location.keys().hasAll(['latitudeCell', 'longitudeCell'])
            && request.resource.data.location.latitudeCell is int
            && request.resource.data.location.latitudeCell >= -9000
            && request.resource.data.location.latitudeCell <= 9000
            && request.resource.data.location.longitudeCell is int
            && request.resource.data.location.longitudeCell >= -18000
            && request.resource.data.location.longitudeCell <= 18000));
      allow update: if signedIn() && validVoteUpdate();
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'audioUrl', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300
          && (request.resource.data.text.size() > 0
            || (request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.size() > 0
              && request.resource.data.audioUrl.size() <= 2000))
          && (!request.resource.data.keys().hasAny(['audioUrl'])
            || (request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.size() > 0
              && request.resource.data.audioUrl.size() <= 2000))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
